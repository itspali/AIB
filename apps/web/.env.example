# All three values must come from the SAME Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Silent signup API (required in production; send as X-Signup-Api-Secret header)
# SIGNUP_API_SECRET=generate-a-long-random-secret

# App Console impersonation cookie signing (required for console impersonation)
# CONSOLE_IMPERSONATION_SECRET=generate-a-long-random-secret

# App Console MFA — set to true only in local/dev (never in production)
# APP_CONSOLE_MFA_OPTIONAL=true

# Maintenance mode banner (public read)
# NEXT_PUBLIC_MAINTENANCE_MODE=false

# Stripe billing (console subscriptions — Phase 5)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional email (quotation send via Resend)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=quotes@yourdomain.com

# Optional — override browser for local PDF generation (Chrome/Edge are auto-detected on Windows)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# GST_VERIFY_API_KEY=your-gstverify-api-key
# Or Sandbox.co.in: SANDBOX_API_KEY + SANDBOX_ACCESS_TOKEN
# Or custom GSP proxy: GST_PORTAL_LOOKUP_URL=https://your-gsp/commonapi/v1.3/search
