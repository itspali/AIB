# All three values must come from the SAME Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — full GSTIN lookup (legal name, address) in entity forms
# GST_VERIFY_API_KEY=your-gstverify-api-key
# Or Sandbox.co.in: SANDBOX_API_KEY + SANDBOX_ACCESS_TOKEN
# Or custom GSP proxy: GST_PORTAL_LOOKUP_URL=https://your-gsp/commonapi/v1.3/search